{
    "name": "beautiful-backgrounds",
    "version": "2.1.0",
    "description": "A collection of customizable web components for creating dynamic, animated backgrounds, featuring a variety of effects including a star field and a digital rain. ",
    "keywords": [
        "ambient",
        "animated-background",
        "animation",
        "background",
        "background-effects",
        "beautiful-backgrounds",
        "canvas",
        "canvas-animation",
        "custom-elements",
        "dynamic-background",
        "html5-canvas",
        "interactive-background",
        "star-field",
        "typescript",
        "visual-effects",
        "web-components"
    ],
    "license": "MIT",
    "author": "Niekes",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Niekes/beautiful-backgrounds.git"
    },
    "files": [
        "build",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "./build/bb.js",
    "module": "./build/bb.es.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/bb.es.js",
            "require": "./build/bb.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "rm -rf build coverage",
        "typecheck": "tsc --noEmit",
        "build": "npm run clean && npm run typecheck && vp pack",
        "pretest": "npm run typecheck",
        "test": "vp test run",
        "test:watch": "vp test",
        "coverage": "vp test run --coverage",
        "fmt": "vp fmt",
        "lint:code": "vp lint && vp fmt --check",
        "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --min-score 100 --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
        "lint": "npm run lint:code && npm run lint:fallow",
        "verify": "npm run lint && npm run typecheck && npm run coverage",
        "hooks:install": "fallow hooks install --target git && fallow hooks install --target agent --agent claude",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "gifs": "npm run build-storybook && node scripts/record-gifs.mjs",
        "prepack": "npm run build",
        "badges": "node scripts/badges.mjs"
    },
    "dependencies": {},
    "devDependencies": {
        "@storybook/addon-a11y": "^10.6.8",
        "@storybook/addon-docs": "^10.6.8",
        "@storybook/addon-vitest": "^10.6.8",
        "@storybook/web-components-vite": "^10.6.8",
        "@types/node": "^26.6.6",
        "@vitest/browser-playwright": "5.1.0",
        "@vitest/coverage-v8": "5.1.0",
        "fallow": "3.46.0",
        "gifenc": "^1.0.3",
        "lit": "^3.3.3",
        "playwright": "^1.65.1",
        "storybook": "^10.6.8",
        "typescript": "~7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "vite-plus": "1.7.0",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "lit": "^3.0.0"
    },
    "overrides": {
        "storybook": {
            "vite-plus": "$vite-plus"
        },
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "vitest": "5.1.0"
    }
}
