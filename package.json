{
    "name": "beautiful-backgrounds",
    "version": "1.1.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Niekes/beautiful-backgrounds.git"
    },
    "main": "./build/bb.js",
    "module": "./build/bb.es.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/bb.es.js",
            "require": "./build/bb.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "build",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rm -rf build",
        "typecheck": "tsc --noEmit",
        "dev": "vite",
        "build": "npm run clean && tsc && vite build",
        "build:types": "tsc --emitDeclarationOnly --declaration --outDir build",
        "preview": "vite preview",
        "pretest": "npm run typecheck",
        "test": "vitest --project storybook --run",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepack": "npm run build"
    },
    "dependencies": {},
    "peerDependencies": {
        "lit": "^3.0.0"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.6.3",
        "@storybook/addon-docs": "^10.6.3",
        "@storybook/addon-vitest": "^10.6.3",
        "@storybook/web-components-vite": "^10.6.3",
        "@types/d3": "^7.4.3",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "d3": "^7.9.0",
        "storybook": "^10.6.3",
        "typescript": "~7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "lit": "^3.3.3",
        "@vitest/browser-playwright": "^5.0.5",
        "playwright": "^1.64.1"
    },
    "keywords": [
        "canvas",
        "animation",
        "ambient",
        "background",
        "typescript",
        "web-components",
        "background-effects",
        "animated-background",
        "star-field",
        "custom-elements",
        "dynamic-background",
        "visual-effects",
        "interactive-background",
        "canvas-animation",
        "beautiful-backgrounds",
        "html5-canvas"
    ],
    "author": "Niekes",
    "license": "MIT",
    "description": "A collection of customizable web components for creating dynamic, animated backgrounds, featuring a variety of effects including a star field and a digital rain. "
}
